# 复制为 .env 并按需修改，docker-compose 会自动读取
SECRET_KEY=change-this-to-a-random-long-string
DEFAULT_COST_PER_IMAGE=0.3
DEFAULT_DAILY_QUOTA=50
IMAGE_EXPIRE_DAYS=15
CLEANUP_INTERVAL_HOURS=6

# 留空则以"占位图演示模式"运行（不产生真实费用，方便先跑通全流程）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

RELAY_PUBLIC_BASE_URL=https://dailybonushub.com
